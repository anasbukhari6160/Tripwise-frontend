# Development only: the target the Vite dev server proxies /api to.
# Ignored by production builds. In production and on Vercel, /api is proxied
# to the backend by the rewrite in vercel.json, so no origin is bundled.
VITE_API_URL=http://localhost:3000

VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
